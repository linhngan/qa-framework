{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.auth/**)",
      "Read(./**/*storageState*.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm run test:prod*)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:list)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:safety)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}\"/scripts/vault-sync.mjs --from-hook" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}\"/scripts/vault-sync.mjs --session-start" }
        ]
      }
    ]
  }
}
