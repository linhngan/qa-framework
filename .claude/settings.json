{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.auth/**)",
      "Read(./**/*storageState*.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm run test:prod*)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:list)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:safety)"
    ]
  }
}
