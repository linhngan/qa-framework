{
  "name": "qa-framework",
  "version": "0.1.0",
  "private": true,
  "description": "A framework that tests the supplied course applications.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "cross-env APP_ENV=dev playwright test",
    "test:prod": "cross-env APP_ENV=prod playwright test",
    "test:list": "cross-env APP_ENV=dev playwright test --list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:safety": "node --test \"safety/**/*.test.ts\" \"safety-tests/**/*.test.mjs\"",
    "vault:sync": "node scripts/vault-sync.mjs --write",
    "vault:check": "node scripts/vault-sync.mjs --check",
    "vault:validate": "node scripts/vault-sync.mjs --check && node scripts/vault-sync.mjs --links",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.10.5",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
}
